# Copy this file to .env and adjust if needed.

# Local Postgres from docker-compose.yml (port 5438 avoids clashing with other Postgres instances).
# Using ServBay's PostgreSQL instead? Point this at it, e.g. port 5432 with your ServBay password.
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/roomfinder"

# Signs the session cookie. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# The site's public address, used for links in emails and Telegram alerts.
# Optional locally (defaults to http://localhost:3000); set it in production.
# APP_URL="https://your-app.vercel.app"

# Password for the admin account that `npm run db:seed` creates (admin@roomfinder.local).
# Without it, the seed uses "admin12345" — fine on your laptop, never in production.
# SEED_ADMIN_PASSWORD="choose-a-strong-password"

# Shown in the footer and on the About/Privacy pages as the way to reach a person.
# CONTACT_EMAIL="roomfinder@example.com"

# --- Email (password reset, "confirm your email") ----------------------------
# New students must open the link in their welcome email before they can request
# viewings. Locally the link is printed in the terminal running `npm run dev`.
# Without RESEND_API_KEY, emails are printed in the terminal running the app instead.
# Get a free key at https://resend.com
# RESEND_API_KEY="re_..."
# EMAIL_FROM="RoomFinder <noreply@your-domain.com>"

# --- Telegram alerts ----------------------------------------------------------
# Without these, alerts are printed in the terminal instead. Create a bot by
# messaging @BotFather in Telegram (/newbot); it gives you the token and username.
# TELEGRAM_BOT_TOKEN="123456789:AA..."
# TELEGRAM_BOT_USERNAME="RoomFinderKhBot"
# Any long random string. Telegram sends it back with every update so the webhook
# knows the request is real. Used by `npm run telegram:poll` locally too.
# TELEGRAM_WEBHOOK_SECRET="another-long-random-string"
